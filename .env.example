# Aria Engine — Docker Compose configuration example.
# Copy to `.env` and adjust. DO NOT commit your real `.env` (it may hold tokens).

# ---- Image ----
# Tag assigned to the built image (shared by both services).
ENGINE_IMAGE=aria-engine:latest
# CPU build base. The runtime image reuses this same image by default, so the
# glibc of the binary always matches what it runs on. Override only for other
# architectures (e.g. an aarch64 rust image).
BUILD_IMAGE=rust:1-slim
# RUNTIME_IMAGE defaults to BUILD_IMAGE; set it only for the CUDA image, e.g.
# nvidia/cuda:12.8.0-runtime-ubuntu22.04 (handled by docker-compose.cuda.yml).
# Build features: leave empty for CPU; the CUDA override file forces "cuda".
FEATURES=
# Optional version string baked into the binary (defaults to crate version).
ARIA_ENGINE_VERSION=

# ---- Region / hub ----
# .com -> Hugging Face; .cn -> ModelScope. The container regenerates engine.yml
# from SITE_URL when this is set, so it overrides a pre-mounted host config.
SITE_URL=https://ariacompute.com
UPGRADE_URL=
# Only the token matching SITE_URL is used. Leave both empty for public models.
HF_TOKEN=
MODELSCOPE_API_TOKEN=

# ---- Compute ----
# auto | cpu | cuda. Use "cuda" only with the CUDA image (docker-compose.cuda.yml).
COMPUTE=auto

# ---- Services / ports ----
# Leave a MODEL empty to disable that service (the container idles instead of
# crash-looping). PORT defaults to 8010 (encoder) / 8011 (decoder) when empty.
ENCODER_MODEL=afm-de
ENCODER_PORT=8010
DECODER_MODEL=afm-dd
DECODER_PORT=8011

# ---- Models ----
# 0 = use weights already on the host (offline-first; bind-mounted via ARIA_DATA_DIR).
# 1 = download the checkpoint on first run (needs network + the matching hub token).
AUTO_DOWNLOAD=0

# ---- Host data dir (bind-mounted into /data/aria) ----
# Absolute path to the host's Aria Compute home. The engine.yml (config) and
# models/ (checkpoints) there are used directly — no download needed.
# Set this to the directory that already holds ~/.ariacompute/models/{afm-de,afm-dd}.
# The shell expands ${HOME}; if your Compose can't, write an absolute path.
ARIA_DATA_DIR=${HOME}/.ariacompute

# ---- Logging ----
# Rust tracing filter; see `RUST_LOG` (default info). e.g. debug, aria_engine=debug
RUST_LOG=info

# ---- Proxy (optional, for the container's egress) ----
# The host reaches the Hub through a local proxy.
# A container cannot use 127.0.0.1 (that's the container itself), so point these
# at host.docker.internal (docker-compose maps it to the host gateway). Leave empty
# if the container has direct internet access.
# HTTPS_PROXY=http://host.docker.internal:7897
# HTTP_PROXY=http://host.docker.internal:7897
# NO_PROXY=127.0.0.1,localhost,host.docker.internal

# ---- GPU (used only by docker-compose.cuda.yml) ----
CUDA_BUILD_IMAGE=nvidia/cuda:12.8.0-devel-ubuntu22.04
CUDA_RUNTIME_IMAGE=nvidia/cuda:12.8.0-runtime-ubuntu22.04
NVIDIA_VISIBLE_DEVICES=all
